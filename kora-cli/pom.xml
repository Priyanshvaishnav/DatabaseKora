<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.koradb</groupId>
        <artifactId>kora-db</artifactId>
        <version>2.0.1</version>
    </parent>

    <artifactId>kora-cli</artifactId>
    <name>KoraDB CLI</name>
    <description>
        Interactive command-line REPL client.
        Implemented in Phase 11.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.koradb</groupId>
            <artifactId>kora-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.koradb</groupId>
            <artifactId>kora-server</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.koradb</groupId>
            <artifactId>kora-ai</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>dev.koradb.cli.Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <finalName>koradb-cli</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
